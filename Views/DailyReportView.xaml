<UserControl x:Class="MonthlyReportGenerator.Views.DailyReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:MonthlyReportGenerator">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 元信息区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="年份" VerticalAlignment="Center" />
            <ComboBox Width="90" Margin="6,0,18,0"
                      ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
            <TextBlock Text="月份" VerticalAlignment="Center" />
            <ComboBox Width="64" Margin="6,0,18,0"
                      ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" />
            <TextBlock Text="实施记录日报" VerticalAlignment="Center" FontWeight="Bold" />
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="导出 XLSX" Command="{Binding ExportCommand}" Appearance="Primary" />
            <ui:Button Content="清空表单" Command="{Binding ClearCommand}" Appearance="Danger" Margin="8,0,0,0" />
        </StackPanel>

        <!-- 整月日报表（每天两行：今日完成/明日计划） -->
        <controls:PerformanceDataGrid Grid.Row="2"
                     Style="{StaticResource {x:Type ui:DataGrid}}"
                     ItemsSource="{Binding Days}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserSortColumns="False"
                     HeadersVisibility="Column"
                     GridLinesVisibility="All"
                     SelectionUnit="Cell"
                     EnableRowVirtualization="False"
                     RowHeight="42"
                     PreviewMouseLeftButtonDown="OnDataGridPreviewMouseLeftButtonDown">
            <controls:PerformanceDataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRestDay}" Value="True">
                            <Setter Property="Background" Value="#FEE2E2" />
                            <Setter Property="BorderBrush" Value="#FECACA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:PerformanceDataGrid.RowStyle>
            <controls:PerformanceDataGrid.Columns>
                <DataGridTextColumn Header="日期" IsReadOnly="True" Width="110"
                                    Binding="{Binding Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                <DataGridTextColumn Header="星期" IsReadOnly="True" Width="60"
                                    Binding="{Binding WeekdayText, Mode=OneWay}" />
                <DataGridTemplateColumn Header="今日完成" Width="*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DoneToday, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="2,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DoneToday, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="40" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="明日计划" Width="*" MinWidth="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PlanTomorrow, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="2,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding PlanTomorrow, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="40" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="项目技术负责人" Width="120"
                                    Binding="{Binding TechLeader, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="项目实施人员" Width="120"
                                    Binding="{Binding Implementer, UpdateSourceTrigger=PropertyChanged}" />
            </controls:PerformanceDataGrid.Columns>
        </controls:PerformanceDataGrid>

        <TextBlock Grid.Row="3" Text="{Binding NoticeText}" Foreground="#E8A33D" Margin="0,6,0,0" />
    </Grid>
</UserControl>
