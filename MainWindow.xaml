<ui:FluentWindow x:Class="MonthlyReportGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:MonthlyReportGenerator"
        Title="科烽智能AGV月报生成工具"
        Width="1280" Height="880"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：FluentWindow 内容延伸到标题区，必须放 TitleBar 才有标题与窗口按钮 -->
        <ui:TitleBar Grid.Row="0" Title="科烽智能AGV月报生成工具">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 元信息区 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="年份" VerticalAlignment="Center" />
                <ComboBox Width="90" Margin="6,0,18,0"
                          ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
                <TextBlock Text="月份" VerticalAlignment="Center" />
                <ComboBox Width="64" Margin="6,0,18,0"
                          ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" />
                <TextBlock Text="姓名" VerticalAlignment="Center" />
                <TextBox Width="110" Margin="6,0,18,0"
                         Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="工程师等级" VerticalAlignment="Center" />
                <ComboBox x:Name="LevelCombo" Width="120" Margin="6,0,18,0"
                          ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" />
                <TextBlock Text="{Binding TitlePreview}" VerticalAlignment="Center" FontWeight="Bold" />
            </StackPanel>

            <!-- 工具栏 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Appearance="Primary" />
                <ui:Button Content="导出 XLSX" Command="{Binding ExportXlsxCommand}" Appearance="Success" Margin="8,0,0,0" />
                <ui:Button Content="清空表单" Command="{Binding ClearCommand}" Appearance="Danger" Margin="8,0,0,0" />
            </StackPanel>

            <!-- 整月明细表 -->
            <controls:PerformanceDataGrid x:Name="MainGrid" Grid.Row="2"
                         Style="{StaticResource {x:Type ui:DataGrid}}"
                         ItemsSource="{Binding Days}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserSortColumns="False"
                         HeadersVisibility="Column"
                         GridLinesVisibility="All"
                         SelectionUnit="Cell"
                         EnableRowVirtualization="False"
                         RowHeight="42"
                         PreviewMouseLeftButtonDown="OnDataGridPreviewMouseLeftButtonDown">
                <controls:PerformanceDataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <!-- 周末/法定节假日（补班日除外）红底高亮，与原网页版一致 -->
                            <DataTrigger Binding="{Binding IsRestDay}" Value="True">
                                <Setter Property="Background" Value="#FEE2E2" />
                                <Setter Property="BorderBrush" Value="#FECACA" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:PerformanceDataGrid.RowStyle>
                <controls:PerformanceDataGrid.Columns>
                    <DataGridTextColumn Header="日期" IsReadOnly="True" Width="110"
                                        Binding="{Binding Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                    <DataGridTextColumn Header="星期" IsReadOnly="True" Width="60"
                                        Binding="{Binding WeekdayText, Mode=OneWay}" />
                    <DataGridTextColumn Header="上班地点" Width="140"
                                        Binding="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="工作内容" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WorkContent, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="2,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding WorkContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="40" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="上班时间" Width="204">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 下拉框常驻：单击即可直接命中并展开（预热 + AutomationPeer 禁用负责性能） -->
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="78" Tag="start:09" GotKeyboardFocus="OnTimeComboFocus"
                                              ItemsSource="{Binding DataContext.HourOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              SelectedItem="{Binding StartHour, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                    <ComboBox Width="78" Tag="start:09" GotKeyboardFocus="OnTimeComboFocus"
                                              ItemsSource="{Binding DataContext.MinuteOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              SelectedItem="{Binding StartMinute, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="×" Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                            FontSize="14" VerticalAlignment="Center"
                                            Tag="start" Click="OnClearTimeClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="下班时间" Width="204">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="78" Tag="end:17" GotKeyboardFocus="OnTimeComboFocus"
                                              ItemsSource="{Binding DataContext.HourOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              SelectedItem="{Binding EndHour, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                                    <ComboBox Width="78" Tag="end:17" GotKeyboardFocus="OnTimeComboFocus"
                                              ItemsSource="{Binding DataContext.MinuteOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                              SelectedItem="{Binding EndMinute, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="×" Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                            FontSize="14" VerticalAlignment="Center"
                                            Tag="end" Click="OnClearTimeClick" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="工作时长(h)" IsReadOnly="True" Width="104"
                                        Binding="{Binding WorkHours, StringFormat=0.00, Mode=OneWay}" />
                    <DataGridTextColumn Header="加班时长(h)" IsReadOnly="True" Width="104"
                                        Binding="{Binding OvertimeHours, StringFormat=0.00, Mode=OneWay}" />
                    <DataGridTextColumn Header="项目出勤" IsReadOnly="True" Width="84"
                                        Binding="{Binding ProjectAttendance, StringFormat=0.00, Mode=OneWay}" />
                </controls:PerformanceDataGrid.Columns>
            </controls:PerformanceDataGrid>

            <!-- 底部：统计表格 + 提示 -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 月度汇总统计 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="月度汇总统计" FontWeight="Bold" Margin="0,0,0,4" />
                        <ui:DataGrid ItemsSource="{Binding SummaryRows}"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                     CanUserSortColumns="False" CanUserReorderColumns="False"
                                     IsReadOnly="True"
                                     HeadersVisibility="Column"
                                     GridLinesVisibility="All"
                                     RowHeight="28"
                                     Width="440"
                                     MaxHeight="300"
                                     VerticalScrollBarVisibility="Auto">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="统计项" Width="*"
                                                    Binding="{Binding Name, Mode=OneWay}" />
                                <DataGridTextColumn Header="数值" Width="90"
                                                    Binding="{Binding Value, Mode=OneWay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </StackPanel>

                    <!-- 项目地点汇总 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="项目地点汇总" FontWeight="Bold" Margin="0,0,0,4" />
                        <ui:DataGrid ItemsSource="{Binding LocationSummaries}"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False" CanUserDeleteRows="False"
                                     CanUserSortColumns="False" CanUserReorderColumns="False"
                                     IsReadOnly="True"
                                     HeadersVisibility="Column"
                                     GridLinesVisibility="All"
                                     RowHeight="28"
                                     MaxHeight="300"
                                     VerticalScrollBarVisibility="Auto">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Header="项目地点" Width="*"
                                                    Binding="{Binding Location, Mode=OneWay}" />
                                <DataGridTextColumn Header="出勤天数(天)" Width="110"
                                                    Binding="{Binding AttendanceDays, StringFormat=0.0, Mode=OneWay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="加班时长(h)" Width="110"
                                                    Binding="{Binding OvertimeHours, StringFormat=0.00, Mode=OneWay}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding WarningText}" Foreground="#E8A33D" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
