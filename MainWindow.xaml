<ui:FluentWindow x:Class="MonthlyReportGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MonthlyReportGenerator.ViewModels"
        xmlns:views="clr-namespace:MonthlyReportGenerator.Views"
        Title="科烽智能AGV月报生成工具"
        Width="1280" Height="880"
        WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <vm:EqualsToBoolConverter x:Key="TabEquals" />
        <vm:EqualsToVisibilityConverter x:Key="TabToVisibility" />
        <!-- 原生 ToggleButton 的标签样式（WPF-UI 无 ToggleButton 控件） -->
        <Style TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#005FB8" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <ui:TitleBar Grid.Row="0" Title="科烽智能AGV月报生成工具">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 公共区：姓名/等级（三页共享） -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="姓名" VerticalAlignment="Center" />
                <TextBox Width="110" Margin="6,0,18,0"
                         Text="{Binding Profile.EmployeeName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="工程师等级" VerticalAlignment="Center" />
                <ComboBox x:Name="LevelCombo" Width="120" Margin="6,0,18,0"
                          ItemsSource="{Binding Profile.Levels}" SelectedItem="{Binding Profile.Level}" />
            </StackPanel>

            <!-- 三个标签页 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <ToggleButton Content="月报" Margin="0,0,8,0"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource TabEquals}, ConverterParameter=0}" />
                <ToggleButton Content="日报" Margin="0,0,8,0"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource TabEquals}, ConverterParameter=1}" />
                <ToggleButton Content="周报"
                              IsChecked="{Binding SelectedTab, Converter={StaticResource TabEquals}, ConverterParameter=2}" />
            </StackPanel>

            <!-- 三个页面视图常驻（仅切换 Visibility，避免每次切换重建视觉树） -->
            <Grid Grid.Row="2">
                <views:MonthlyReportView DataContext="{Binding MonthlyPage}"
                                         Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabToVisibility}, ConverterParameter=0}" />
                <views:DailyReportView DataContext="{Binding DailyPage}"
                                       Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabToVisibility}, ConverterParameter=1}" />
                <views:WeeklyReportView DataContext="{Binding WeeklyPage}"
                                        Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabToVisibility}, ConverterParameter=2}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
